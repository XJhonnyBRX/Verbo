# =============================================================================
# VERBO
#
# Este arquivo é versionado de propósito: ele não guarda segredo nenhum.
# Segredos vão em .env.local, que está no .gitignore.
# =============================================================================

# Permite que a amostra de desenvolvimento seja usada num build de produção.
#
# APAGAR ESTA LINHA É O PORTÃO DE LANÇAMENTO. Enquanto ela existir, o VERBO
# pode subir exibindo texto bíblico que nunca foi conferido. Quando o
# importador do Ciclo 1 rodar com uma tradução verificada, apague AS DUAS
# linhas — o build passa a falhar se alguém tentar publicar com a amostra.
#
# São duas porque a amostra é lida no servidor e no cliente, e só variável
# com prefixo NEXT_PUBLIC_ chega ao bundle do navegador.
VERBO_ALLOW_SAMPLE=1
NEXT_PUBLIC_VERBO_ALLOW_SAMPLE=1
